{
  "functions": {
    "src/app/api/scrape/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/solarquotepro-pipeline/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/outreach/lagos10k/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/outreach/ibadan10k/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/jiji/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/webhooks/payment/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/outreach/solar-hybrid/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/outreach/regular-business/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/harvest",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/solarquotepro-pipeline?cron=true",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/outreach/lagos10k?cron=true",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/outreach/ibadan10k?cron=true",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/outreach/solar-hybrid?cron=true",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/outreach/regular-business?cron=true",
      "schedule": "0 10 * * *"
    }
  ]
}
