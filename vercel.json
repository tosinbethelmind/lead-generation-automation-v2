{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/redeem",
      "destination": "/redeem.html"
    },
    {
      "source": "/redeem/(.*)",
      "destination": "/redeem.html"
    },
    {
      "source": "/affiliates",
      "destination": "/affiliates.html"
    },
    {
      "source": "/affiliate",
      "destination": "/affiliates.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"bethelmind_business_os.apk\""
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "src/app/api/scrape/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/solarquotepro-pipeline/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/outreach/lagos10k/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/outreach/ibadan10k/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/jiji/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/webhooks/payment/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/outreach/solar-hybrid/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/outreach/regular-business/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/autonomous-blog/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/harvest",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/autonomous-blog",
      "schedule": "0 6 * * *"
    }
  ]
}
