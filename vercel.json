{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/redeem",
      "destination": "/redeem.html"
    },
    {
      "source": "/redeem/(.*)",
      "destination": "/redeem.html"
    },
    {
      "source": "/affiliates",
      "destination": "/affiliates.html"
    },
    {
      "source": "/affiliate",
      "destination": "/affiliates.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"bethelmind_business_os.apk\""
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/autonomous-blog",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/commerce-automation",
      "schedule": "0 8 * * *"
    }
  ]
}
