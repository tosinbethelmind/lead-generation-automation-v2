{
  "name": "tmp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start-all": "concurrently \"npm run dev\" \"npm run local-runner\"",
    "start-all-with-outreach": "concurrently \"npm run dev\" \"npm run local-runner\" \"npm run whatsapp-service\"",
    "dev": "next dev -p 3006",
    "build": "npx cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start -p 3005",
    "lint": "eslint",
    "redeploy": "npx vercel --prod --yes",
    "typecheck": "tsc --noEmit",
    "setup": "node setup.js",
    "local-trigger": "node scripts/local_trigger.js",
    "auto-setup": "node scripts/auto_setup.js",
    "fully-automated-setup": "node scripts/fully_automated_setup.js",
    "demo": "npx playwright test tests/e2e/demo_recorder.spec.ts --headed",
    "whatsapp-service": "node scripts/whatsapp_baileys.js",
    "command-center": "node scripts/unified_whatsapp_command_center.js",
    "start-full-stack": "concurrently \"npm run dev\" \"npm run whatsapp-service\" \"npm run command-center\"",
    "setup-tor": "node scripts/setup_tor.js",
    "local-runner": "node scripts/keep_alive_runner.js",
    "test-queue": "ts-node scripts/test_hybrid_queue.ts",
    "solarquotepro-outreach": "node scripts/solarquotepro_multi_channel_outreach.js",
    "solarquotepro-pipeline": "node scripts/solarquotepro_isolated_runner.js",
    "setup:lean": "node scripts/lean_stack_setup.js",
    "deploy:lean": "bash scripts/deploy_lean_stack.sh",
    "phase1:start": "node scripts/phase1_runner.js",
    "test:scaling": "node scripts/test_scaling_pipeline.js",
    "test:chatbot": "node scripts/test_chatbot_automation.js",
    "test:master": "node scripts/master_system_audit.js",
    "handover": "node scripts/automated_handover.js",
    "outreach:all": "node scripts/unified_outreach_master.js",
    "outreach:all:dry": "node scripts/unified_outreach_master.js --dry-run",
    "outreach:lagos": "node scripts/unified_outreach_master.js --engine=1",
    "outreach:lagos:dry": "node scripts/unified_outreach_master.js --engine=1 --dry-run",
    "outreach:nigeria": "node scripts/unified_outreach_master.js --engine=2",
    "outreach:nigeria:dry": "node scripts/unified_outreach_master.js --engine=2 --dry-run"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@magenta/music": "^1.23.1",
    "@sparticuz/chromium": "^131.0.1",
    "@supabase/supabase-js": "^2.106.2",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "imap": "^0.8.19",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.17.0",
    "mailparser": "^3.7.2",
    "next": "16.2.7",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pitchy": "^2.0.0",
    "puppeteer-core": "^25.2.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tone": "^14.8.39",
    "twilio": "^4.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "ffmpeg-static": "^5.3.0",
    "open": "^9.0.0",
    "postcss": "^8.5.26",
    "socks-proxy-agent": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "crawlee": "^3.18.0"
  }
}
