{
  "appId": "com.bethelmind.futurelinkcarhire",
  "appName": "Future Link Car Hire",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://www.bethelmindanalytics.com/preview/future-link-car-hire",
    "cleartext": true,
    "allowNavigation": [
      "*.bethelmindanalytics.com",
      "wa.me",
      "api.whatsapp.com",
      "*.paystack.co",
      "*.moniepoint.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}